<%= form_with(model: profile, url: profile_path, local: true, class: "space-y-6") do |f| %>
  <% if profile.errors.any? %>
    <div class="bg-red-50 text-red-500 p-4 rounded-md mb-4">
      <h2><%= pluralize(profile.errors.count, "erro") %> impediram de salvar:</h2>
      <ul>
        <% profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.fields_for :user do |user_fields| %>
      <%= user_fields.label :name, "Seu Nome Completo", class: "block text-sm font-medium text-gray-700" %>
      <%= user_fields.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
    <% end %>
  </div>

  <div>
    <%= f.label :phone, "Telefone / WhatsApp", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :phone, placeholder: "(11) 99999-9999", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div>
    <%= f.label :description, "Sua Bio / Experiência", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 4, placeholder: "Conte um pouco sobre suas habilidades...", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div class="flex items-center">
    <%= f.check_box :active, class: "h-4 w-4 text-slate-600 focus:ring-slate-500 border-gray-300 rounded" %>
    <%= f.label :active, "Perfil Ativo (Visível para empresas)", class: "ml-2 block text-sm text-gray-900" %>
  </div>

  <%= f.collection_check_boxes :category_ids, Category.all, :id, :name %>

  <div>
    <%= f.submit "Salvar Perfil", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-800 hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500" %>
  </div>
<% end %>