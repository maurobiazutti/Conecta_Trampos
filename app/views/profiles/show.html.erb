<div class="max-w-2xl mx-auto mt-10 p-6 bg-white shadow-md rounded-lg">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Meu Perfil</h1>
    <%= link_to "Editar", edit_profile_path, class: "px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-md text-sm font-medium" %>
  </div>

  <div>
    <p><%= @profile.user.name %></p>
  </div>

  <div class="space-y-4">
    <div>
      <h3 class="text-sm font-medium text-gray-500">Status</h3>
      <p class="<%= @profile.active ? 'text-green-600' : 'text-red-600' %> font-semibold">
        <%= @profile.active ? "Ativo e disponível" : "Inativo" %>
      </p>
    </div>

    <div>
      <h3 class="text-sm font-medium text-gray-500">Telefone</h3>
      <p class="text-gray-900"><%= @profile.phone %></p>
    </div>

    <div>
      <h3 class="text-sm font-medium text-gray-500">Sobre</h3>
      <p class="text-gray-900 whitespace-pre-line"><%= @profile.description %></p>
    </div>
  </div>
</div>