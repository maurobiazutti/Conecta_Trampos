<%= form_with(model: address, url: address_path, local: true, class: "space-y-6") do |f| %>
  <% if address.errors.any? %>
    <div class="bg-red-50 text-red-500 p-4 rounded-md mb-4">
      <h2><%= pluralize(address.errors.count, "erro") %> impediram de salvar:</h2>
      <ul>
        <% address.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :cep, "CEP", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :cep, placeholder: "00000-000", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div>
    <%= f.label :street, "Rua", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :street, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div>
    <%= f.label :number, "Numero", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :number, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div>
    <%= f.label :complement, "Complemento", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :complement, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div>
    <%= f.label :neighborhood, "Bairro", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :neighborhood, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div>
    <%= f.label :city, "Cidade", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :city, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div>
    <%= f.label :state, "Estado", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :state, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div>
    <%= f.submit "Salvar Endereco", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-800 hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500" %>
  </div>
<% end %>
