<%= form_with(model: service_request, local: true, class: "space-y-6") do |f| %>
  <% if service_request.errors.any? %>
    <div class="bg-red-50 text-red-500 p-4 rounded-md mb-4">
      <h2><%= pluralize(service_request.errors.count, "erro") %> impediram de salvar:</h2>
      <ul>
        <% service_request.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Titulo do Servico", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, placeholder: "Ex.: Reforma de banheiro", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div>
    <%= f.label :category_id, "Categoria", class: "block text-sm font-medium text-gray-700" %>
    <%= f.collection_select :category_id, Category.order(:name), :id, :name, { prompt: "Selecione uma categoria" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div>
    <%= f.label :description, "Descricao do Servico", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 5, placeholder: "Descreva o que voce precisa, prazo e detalhes importantes.", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
  </div>

  <div>
    <%= f.submit "Cadastrar Servico", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-800 hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500" %>
  </div>
<% end %>
